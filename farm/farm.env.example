# Pi connection
PI_HOST=piusb@192.168.1.66
PI_SSH_PORT=22
# PI_SSH_KEY=/home/USER/.ssh/klipper_farm_ed25519
# PI_SSH_EXTRA_OPTS=-o StrictHostKeyChecking=accept-new
# PI_BRIDGE_HOST=192.168.1.66

# Port/index model
PORT_BASE=5000
PORT_COUNT=16
SER2NET_BAUD=250000

# Server orchestration
PRIND_UPSTREAM=https://github.com/mkuf/prind.git
PRINTER_ROOT=/srv/printers
PROJECT_PREFIX=p
MOONRAKER_PORT_BASE=7200
FRONTEND_PROFILE=mainsail
FRONTEND_SERVICE=mainsail
FRONTEND_PORT_BASE=18080
PROJECT_SERVICES="klipper moonraker mainsail"

# Bridge process
BRIDGE_SCRIPT=/home/USER/Impr3D/KlipperFarming/bridge/start_socat.sh
BRIDGE_DIR=/run/klipper-bridges

# Health policy
BAD_GRACE_SEC=300
AUTO_STOP_SEC=3600
POLL_INTERVAL_SEC=30

# Local state
STATE_DIR=/var/lib/klipper-farm
MAP_FILE=/var/lib/klipper-farm/device-index.tsv
BRIDGE_PID_DIR=/var/lib/klipper-farm/bridge-pids
HEALTH_DIR=/var/lib/klipper-farm/health
LOG_DIR=/var/lib/klipper-farm/logs

# Pi firewall
APPLY_FIREWALL=1
# ALLOWLIST_FILE defaults to /etc/klipper-farm/allowed_ipv4.txt
